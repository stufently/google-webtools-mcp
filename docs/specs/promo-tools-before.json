 {
  "name": "get_search_analytics",
  "inputSchema": {
   "type": "object",
   "properties": {
    "siteUrl": {
     "type": "string",
     "description": "The site URL exactly as it appears in Google Search Console (e.g., \"https://example.com/\" or \"sc-domain:example.com\")"
    },
    "startDate": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "description": "Start date in YYYY-MM-DD format"
    },
    "endDate": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "description": "End date in YYYY-MM-DD format"
    },
    "dimensions": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "date",
       "query",
       "page",
       "country",
       "device",
       "searchAppearance"
      ],
      "description": "Dimension to group results by"
     },
     "description": "Dimensions to group by (e.g. query, page, date, country, device, searchAppearance)"
    },
    "searchType": {
     "type": "string",
     "enum": [
      "web",
      "image",
      "video",
      "news",
      "discover",
      "googleNews"
     ],
     "default": "web",
     "description": "Search type to analyze"
    },
    "filters": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "dimension": {
        "type": "string",
        "description": "Dimension to filter on (query, page, country, device, searchAppearance)"
       },
       "operator": {
        "type": "string",
        "enum": [
         "contains",
         "equals",
         "notContains",
         "notEquals",
         "includingRegex",
         "excludingRegex"
        ],
        "default": "contains"
       },
       "expression": {
        "type": "string",
        "description": "Filter expression value"
       }
      },
      "required": [
       "dimension",
       "expression"
      ],
      "additionalProperties": false
     },
     "description": "Dimension filters to apply"
    },
    "rowLimit": {
     "type": "number",
     "minimum": 1,
     "maximum": 25000,
     "default": 1000,
     "description": "Maximum rows to return (1-25000)"
    },
    "dataState": {
     "type": "string",
     "enum": [
      "all",
      "final"
     ],
     "default": "all",
     "description": "\"final\" = finalized data only (the API's own default; the newest days are simply absent until they settle), \"all\" = also includes the freshest days, whose numbers may still change"
    },
    "aggregationType": {
     "type": "string",
     "enum": [
      "auto",
      "byPage",
      "byProperty"
     ],
     "default": "auto"
    }
   },
   "required": [
    "siteUrl",
    "startDate",
    "endDate"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
